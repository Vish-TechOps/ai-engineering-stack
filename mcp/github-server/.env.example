# github-server environment variables
# Copy to .env (or inject via your MCP client config) and fill in real values.

# Required: GitHub personal access token (classic or fine-grained).
# Sent as "Authorization: Bearer <token>". Never commit a real token.
# Scopes: "repo" (private repos + issues/PRs), "read:org" (org repos).
GITHUB_TOKEN=

# Optional: GitHub REST API base URL. Defaults to https://api.github.com.
# For GitHub Enterprise Server use https://<host>/api/v3. Must be HTTPS.
GITHUB_API_URL=https://api.github.com
